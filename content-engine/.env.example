# Supabase — los agentes corren en servidor: clave de SERVICIO, no la anónima
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protege los endpoints de cron. Sin esto cualquiera puede quemar el cupo diario.
CRON_SECRET=

# Higgsfield (producción de video y voz)
HIGGSFIELD_API_KEY=

# Un token POR CUENTA, no global: el límite de Meta es por token.
# Se guardan en la tabla accounts, no aquí. Estas son solo las credenciales
# de la app para el flujo OAuth.
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
